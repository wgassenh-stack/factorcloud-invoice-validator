# Demo mode: runs pages on a synthetic portfolio (20 clients, 60 debtors, ~15 months of invoices).
# Nothing is sent to FactorCloud and nothing is written to the database; every screen shows a
# "Demo data" badge. The "Load demo data" switch in the sidebar turns it on for one browser.
# Set NEXT_PUBLIC_DEMO_TOGGLE=false to hide that switch (do this on client-facing sites).
# NEXT_PUBLIC_DEMO_MODE=true forces the whole site into demo mode.
NEXT_PUBLIC_DEMO_TOGGLE=true
NEXT_PUBLIC_DEMO_MODE=false

# Pilot-only shared password. Used when PORTAL_AUTH_MODE is not database.
APP_ACCESS_PASSWORD=
# Test environments only: adds the Driver view on real data. With database sign-in, for factor staff;
# with the shared password, the password holder is the factor's admin with all three views.
# Needs a redeploy.
NEXT_PUBLIC_ADMIN_VIEWS=false
# Required. Signs verification receipts so analyzed fields/files cannot be swapped before submit.
# Use its own long random value (e.g. `openssl rand -base64 48`). There is no fallback to any other setting:
# verification and submission are refused until this is set. Receipts expire after 24 hours.
PORTAL_SIGNING_SECRET=

# Real portal identity. Set PORTAL_AUTH_MODE=database once PostgreSQL is connected and migrations are applied.
PORTAL_AUTH_MODE=pilot
# Development: a normal hosted PostgreSQL URL works here, including Neon.
# Production: point the same setting at FactorCloud's PostgreSQL/RDS database.
DATABASE_URL=
# Hosted PostgreSQL providers commonly require TLS. Set true for Neon/RDS when required.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Long random secret used to sign the portal login session cookie.
AUTH_SESSION_SECRET=

# Client portal identity. These are safe display values for one-client deployments.
NEXT_PUBLIC_PORTAL_CLIENT_NAME=Will's Test Trucking LLC
NEXT_PUBLIC_PORTAL_CLIENT_SHORT_NAME=Will's Test Trucking
NEXT_PUBLIC_PORTAL_ENV_LABEL=Sandbox

# Per-client feature switches. Set any of these to false to hide that module.
NEXT_PUBLIC_FEATURE_INVOICES=true
NEXT_PUBLIC_FEATURE_SUBMIT=true

# FactorCloud sandbox
FACTORCLOUD_API_BASE=https://api.int.factorcloud.com
FACTORCLOUD_FACTOR_ID=eff7fcec-b06a-4269-9f61-33b577f3b24f
FACTORCLOUD_USERNAME=
FACTORCLOUD_PASSWORD=
# Client portals should use a server-side bearer/service credential. Keep interactive staff OTP login off.
FACTORCLOUD_BEARER_TOKEN=
ALLOW_INTERACTIVE_FACTORCLOUD_LOGIN=false
# Each client deployment points at one FactorCloud client ID.
FACTORCLOUD_CLIENT_ID=d9492b53-6545-48d6-87cf-c09ff1cdfc62
FACTORCLOUD_DEBTOR_IDS=a3429767-8107-4f1e-98f7-ecb910e930d4
# Optional. Invoices requested per FactorCloud page (default 100, max 500). Falls back to 20 if FactorCloud rejects it.
FACTORCLOUD_PAGE_SIZE=

# V1 alert thresholds. These can differ by client deployment.
RISK_CONCENTRATION_REVIEW_PCT=30
RISK_CONCENTRATION_HIGH_PCT=50
RISK_VOLUME_SPIKE_RATIO=1.5

# Set to false to hide the monthly Statements page.
NEXT_PUBLIC_FEATURE_STATEMENTS=true

# Document extraction. Start very cheap and move up only if real paperwork needs it.
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING=minimal

# One-time bootstrap values used by npm run user:create.
PORTAL_FACTOR_NAME=FactorCloud Sandbox
PORTAL_USER_EMAIL=
PORTAL_USER_PASSWORD=
PORTAL_USER_NAME=
PORTAL_USER_ROLE=CLIENT_USER

# Optional development credentials used by npm run db:bootstrap.
# If passwords are left blank, the script generates strong random passwords and prints them once.
DEV_FACTOR_ADMIN_EMAIL=factor-admin@factorcloud.local
DEV_FACTOR_ADMIN_PASSWORD=
DEV_FACTOR_ADMIN_NAME=Factor Admin
DEV_CLIENT_USER_EMAIL=client@willstesttrucking.local
DEV_CLIENT_USER_PASSWORD=
DEV_CLIENT_USER_NAME=Will's Test Trucking User

# Flagged invoices get this FactorCloud label (create it under Labels in FactorCloud). Found by name,
# ignoring case and a trailing period; or set its ID directly.
FACTORCLOUD_REVIEW_LABEL=Portal review
FACTORCLOUD_REVIEW_LABEL_ID=
# Optional: rejected invoices swap the review label for this one, if it exists in FactorCloud.
FACTORCLOUD_REJECTED_LABEL=Portal rejected
