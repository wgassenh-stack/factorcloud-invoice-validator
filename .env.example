# Copy to .env.local for local dev; set the same values in Vercel → Settings → Environment Variables.

# Shared password for the whole app (HTTP Basic auth; any username).
# Required in production: the app refuses to serve without it.
APP_ACCESS_PASSWORD=

# FactorCloud
FACTORCLOUD_API_BASE=https://api.int.factorcloud.com
FACTORCLOUD_FACTOR_ID=eff7fcec-b06a-4269-9f61-33b577f3b24f
# Used by the in-app "Sign in to FactorCloud" email-OTP flow.
FACTORCLOUD_USERNAME=
FACTORCLOUD_PASSWORD=
# Optional: a bearer token copied from Postman, used when nobody has signed in through the app.
FACTORCLOUD_BEARER_TOKEN=
# The client invoices are created for (sandbox: Will's Test Trucking LLC).
FACTORCLOUD_CLIENT_ID=d9492b53-6545-48d6-87cf-c09ff1cdfc62
# Comma-separated debtor company IDs to match extracted debtors against (sandbox: Acme Manufacturing LLC).
# Temporary until a FactorCloud company-search endpoint is confirmed.
FACTORCLOUD_DEBTOR_IDS=a3429767-8107-4f1e-98f7-ecb910e930d4

# Document reading (Claude). AI_API_KEY is also accepted for backward compatibility.
ANTHROPIC_API_KEY=
# Optional model override.
EXTRACTION_MODEL=claude-opus-5
